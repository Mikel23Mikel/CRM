{
  "name": "storage-gantt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "watch:build": "chokidar \"src/**/*\" \"index.html\" -c \"vite build\"",
    "serve": "concurrently -n BUILD,PREVIEW -c yellow,cyan \"npm run watch:build\" \"npm run preview\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.5",
    "vite": "^5.4.11"
  }
}
